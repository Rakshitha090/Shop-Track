# ShopTrack Environment Configuration Template
# Copy this file to .env and configure your database settings.

APP_ENV=development
APP_NAME=ShopTrack
APP_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Database Driver Selection: 'supabase' (PostgreSQL) or 'sqlite' (Local)
# ------------------------------------------------------------------------------
DB_CONNECTION=supabase

# --- Option 1: Supabase PostgreSQL (Default) ---
# You can use individual parameters:
SUPABASE_DB_HOST=db.your-supabase-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_DB_SSLMODE=require

# Alternatively, you can paste the full URI instead of individual keys:
# DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# --- Option 2: Local SQLite Database ---
# If you prefer to run locally using an SQLite file, set:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/shoptrack.sqlite
